// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FlowType {
  INCOME
  EXPENSE
}

enum FrequencyType {
  FIJO
  RECURRENTE
  ESPORADICO
}

enum TransactionStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum TransactionSource {
  CSV_IMPORT
  OCR_RECEIPT
  MANUAL
  API
}

enum BatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum Currency {
  CLP
  USD
  EUR
  UF
}

model Category {
  id               String         @id @default(cuid())
  name             String
  flowType         FlowType
  defaultFrequency FrequencyType?
  colorHex         String?        @default("#6366f1")
  icon             String?        @default("Tag")
  isSystem         Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  transactions Transaction[]

  @@unique([name, flowType])
  @@index([flowType])
}

model ImportBatch {
  id           String      @id @default(cuid())
  filename     String
  totalRows    Int         @default(0)
  importedRows Int         @default(0)
  failedRows   Int         @default(0)
  status       BatchStatus @default(PENDING)
  errorLog     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  transactions Transaction[]

  @@index([status, createdAt])
}

model Transaction {
  id              String            @id @default(cuid())
  hash            String            @unique
  date            DateTime
  description     String
  rawDescription  String
  amount          Decimal           @db.Decimal(14, 2)
  currency        Currency          @default(CLP)
  flowType        FlowType
  frequency       FrequencyType     @default(ESPORADICO)
  status          TransactionStatus @default(PENDING_REVIEW)
  source          TransactionSource @default(MANUAL)
  confidenceScore Float?
  metadata        Json?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  batchId String?
  batch   ImportBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  verifiedAt DateTime?
  verifiedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  auditLogs TransactionAudit[]

  @@index([date(sort: Desc)])
  @@index([status, flowType])
  @@index([categoryId])
  @@index([batchId])
  @@index([flowType, frequency, date])
}

model TransactionAudit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  previousState Json
  newState      Json
  changedBy     String?     @default("SYSTEM")
  changeReason  String?
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([createdAt(sort: Desc)])
}
